{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Telegram": {
    "BotToken": "",
    "AllowedChatId": 0
  },
  "LocalLlm": {
    "BaseUrl": "http://localhost:1234",
    "Model": "hermes-3-llama-3.1-8b",
    "TimeoutSeconds": 120,
    "DefaultTemperature": 0.2
  },
  "Storage": {
    "DatabasePath": "%LOCALAPPDATA%/Mira/mira.db",
    "KnowledgeRootPath": "%LOCALAPPDATA%/Mira/knowledge",
    "EnableMarkdownMirror": true
  },
  "Proactive": {
    "RemindersEnabled": true,
    "DailyBriefEnabled": true,
    "WeeklyReviewEnabled": true,
    "WorkoutReminderEnabled": true,
    "KnowledgeAuditEnabled": true,
    "PollIntervalSeconds": 60,
    "TimeZoneId": "",
    "DailyBriefLocalTime": "08:00",
    "WeeklyReviewDay": "Sunday",
    "WeeklyReviewLocalTime": "09:00",
    "KnowledgeAuditDay": "Sunday",
    "KnowledgeAuditLocalTime": "22:00",
    "WorkoutReminderAfterDays": 3,
    "StaleMemoryAfterDays": 90
  },
  "Automation": {
    "Enabled": false,
    "Tasks": [
      {
        "Name": "echo_test",
        "Description": "Echo text for local automation smoke testing",
        "Executable": "cmd.exe",
        "Arguments": ["/c", "echo", "{text}"],
        "RequiresConfirmation": true,
        "TimeoutSeconds": 10
      }
    ]
  }
}
